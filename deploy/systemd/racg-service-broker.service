[Unit]
Description=RACG unprivileged approval protocol relay
After=network-online.target racg-service-authority.service
Wants=network-online.target
Requires=racg-service-authority.service

[Service]
Type=simple
User=racg-broker
Group=racg-broker
ExecStart=/usr/local/bin/racg service-broker --config /etc/racg/service.toml
Restart=on-failure
RestartSec=2s

StateDirectory=racg-broker
ConfigurationDirectory=racg
ReadWritePaths=/var/lib/racg-broker
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
