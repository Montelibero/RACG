[Unit]
Description=RACG privileged service authority
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=racg-broker
ExecStart=/usr/local/bin/racg service-authority --config /etc/racg/service.toml
Restart=on-failure
RestartSec=2s

# Keep authority-owned state and its exclusive lock private.
StateDirectory=racg-authority
ConfigurationDirectory=racg
ReadWritePaths=/var/lib/racg-authority
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
